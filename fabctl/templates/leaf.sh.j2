#!/bin/sh
# {{ name }}: Linux side of a leaf. Generated from intent/fabric.yml by fabctl render.
# FRR decides where packets go; the Linux kernel moves them. This script builds what the
# kernel needs for that: a VRF per tenant, a bridge per VLAN, a VXLAN tunnel per VNI.
# Safe to run again: anything that already exists is left as it is.
set -e
exists() { ip link show "$1" >/dev/null 2>&1; }

# Forward packets, and enable IPv6: BGP unnumbered talks over IPv6 link local addresses.
sysctl -qw net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1
sysctl -qw net.ipv6.conf.all.disable_ipv6=0 net.ipv6.conf.default.disable_ipv6=0
{% for port in ports %}
sysctl -qw net.ipv6.conf.{{ port.name }}.disable_ipv6=0
ip link set {{ port.name }} up
{% endfor %}
{% for t in tenants %}

# Tenant {{ t.name }}: its own routing table (VRF), and L3VNI {{ t.l3vni }} carrying its routed traffic
exists {{ t.name }} || ip link add {{ t.name }} type vrf table {{ t.l3vni }}
ip link set {{ t.name }} up
exists br{{ t.l3vni }} || ip link add br{{ t.l3vni }} type bridge
ip link set br{{ t.l3vni }} master {{ t.name }} up
exists vx{{ t.l3vni }} || ip link add vx{{ t.l3vni }} mtu 1500 type vxlan id {{ t.l3vni }} local {{ loopback }} dstport 4789 nolearning
ip link set vx{{ t.l3vni }} master br{{ t.l3vni }} up
{% for vlan in t.vlans %}

# VLAN {{ vlan.id }} ({{ vlan.name }}): a bridge with the anycast gateway, joined to the fabric by VNI {{ vlan.vni }}
exists br{{ vlan.id }} || ip link add br{{ vlan.id }} type bridge
ip link set br{{ vlan.id }} master {{ t.name }} address {{ anycast_mac }} up
ip addr replace {{ vlan.gateway }} dev br{{ vlan.id }}
exists vx{{ vlan.vni }} || ip link add vx{{ vlan.vni }} mtu 1500 type vxlan id {{ vlan.vni }} local {{ loopback }} dstport 4789 nolearning
ip link set vx{{ vlan.vni }} master br{{ vlan.id }} up
ip link set vx{{ vlan.vni }} type bridge_slave neigh_suppress on learning off
{% endfor %}
{% endfor %}

# Server ports: each one joins the bridge of its VLAN. Servers use standard 1500 byte packets;
# the tunnel adds 50 bytes, and fabric cables carry 9500, so a full packet always fits.
{% for s in servers %}
ip link set {{ s.port }} master br{{ s.vlan }} mtu 1500 up   # {{ s.name }}
{% endfor %}
